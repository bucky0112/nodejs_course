{
  "name": "todo-app-docker",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "app.js",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "node --watch app.js",
    "start": "node app.js",
    "generate": "drizzle-kit generate",
    "migrate": "drizzle-kit migrate",
    "up": "docker compose up -d --build",
    "down": "docker compose down",
    "logs": "docker compose logs -f app"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.38.3",
    "express": "^5.1.0",
    "pg": "^8.13.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.30.1"
  }
}
