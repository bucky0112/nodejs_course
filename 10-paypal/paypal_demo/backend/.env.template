# PayPal Sandbox 憑證設定範本
#
# 使用方式：
# 1. 複製此檔為 .env
# 2. 到 https://developer.paypal.com/dashboard/applications/sandbox
#    建立 App 後取得 Client ID 與 Secret
# 3. .env 已被 .gitignore 排除，請勿 commit 真實憑證

# PayPal Sandbox App 的 Client ID
PAYPAL_CLIENT_ID=your-paypal-client-id

# PayPal Sandbox App 的 Secret（切勿外流或 console.log 印出）
PAYPAL_CLIENT_SECRET=your-paypal-client-secret
