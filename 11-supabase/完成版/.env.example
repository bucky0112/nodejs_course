# 從 Supabase Dashboard > Project Settings > API 取得
SUPABASE_URL=https://你的專案ref.supabase.co
# 新版 publishable key（sb_publishable_...，不是舊的 anon JWT）
SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# 若要用 Drizzle 把 todo app 直接跑在 Supabase 上，從 Dashboard > Connect 複製 Supavisor pooler 字串：
# DATABASE_URL=postgresql://postgres.[REF]:[PWD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
