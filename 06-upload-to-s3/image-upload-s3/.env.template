# ============================================
# AWS S3 環境變數設定範本
# ============================================
#
# 使用方式：
# 1. 複製此檔案為 .env
# 2. 填入你的 AWS 憑證資訊
# 3. 確保 .env 已加入 .gitignore（不要上傳到 Git）
#
# ⚠️ 安全提醒：
# - 絕對不要將真實的 AWS 憑證 commit 到 Git
# - 定期輪換 Access Key
# - 使用最小權限原則（只給 S3 相關權限）

# AWS 區域代碼
# 常見區域：
#   ap-northeast-1 (東京)
#   ap-southeast-1 (新加坡)
#   ap-southeast-2 (雪梨)
#   us-east-1 (維吉尼亞)
#   us-west-2 (奧勒岡)
AWS_REGION=ap-northeast-1

# S3 Bucket 名稱（必須是全球唯一的）
S3_BUCKET_NAME=your-bucket-name

# IAM 使用者的 Access Key ID
# 在 AWS Console > IAM > Users > 你的使用者 > Security credentials 取得
AWS_ACCESS_KEY_ID=your-access-key-id

# IAM 使用者的 Secret Access Key
# 只有在建立時會顯示一次，請妥善保管
AWS_SECRET_ACCESS_KEY=your-secret-access-key
