# 資料庫
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/todo_app

# JWT 密鑰（隨機字串）
JWT_SECRET=請改成你自己的隨機字串

# Google OAuth 憑證（從 Google Cloud Console > API 和服務 > 憑證 取得）
GOOGLE_CLIENT_ID=你的-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=你的-client-secret
# 必須與 Google Console 裡設定的「已授權的重新導向 URI」完全一致
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
